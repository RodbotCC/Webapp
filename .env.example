CLOSE_API_KEY=your_close_api_key_here
CLOSE_USER_ID=your_close_user_id_here
PORT=3141

# Optional: server-side OpenAI key (e.g. Render env) — Oracle works without pasting key in Settings
# OPENAI_API_KEY=sk-...

# Optional: mounted persistent disk on Render/Fly/Railway (defaults to ./data)
# DATA_DIR=/var/data

# CRM source
# file-tree = Close API sync writes data/live_*.json and data/andre_close_focus/snapshot.json
# supabase = use Supabase as live CRM store (optional future mode)
CRM_SOURCE=file-tree

# Supabase — optional future real-time data store
# Project ref is the subdomain of your SUPABASE_URL (e.g. xxxxxxxxxxxx.supabase.co -> ref = xxxxxxxxxxxx)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_SCHEMA=comeketo
